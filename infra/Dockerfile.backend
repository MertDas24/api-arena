FROM mcr.microsoft.com/dotnet/sdk:10.0.401-noble AS build
ARG HOST_PROJECT=APIArena.Api
WORKDIR /src
COPY backend/ backend/
COPY examples/ examples/
COPY global.json global.json
RUN dotnet publish backend/src/${HOST_PROJECT}/${HOST_PROJECT}.csproj -c Release -o /out /p:UseAppHost=false
RUN rm -f /out/appsettings.Development.json

FROM mcr.microsoft.com/dotnet/aspnet:10.0.12-noble AS runtime
USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=app:app /out/ ./
COPY --chmod=755 infra/health.sh /health.sh
ARG HOST_PROJECT=APIArena.Api
ENV HOST_DLL=${HOST_PROJECT}.dll ASPNETCORE_HTTP_PORTS=8080 DOTNET_ENVIRONMENT=Production ASPNETCORE_ENVIRONMENT=Production
USER app
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 CMD ["/health.sh"]
ENTRYPOINT ["/bin/sh", "-c", "exec dotnet \"$HOST_DLL\" \"$@\"", "--"]

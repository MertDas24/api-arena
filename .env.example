# API Arena — environment variable NAMES. Copy to .env (git-ignored) and fill locally.
# Never commit real values. Generate development secrets with scripts/dev-secrets.(ps1|sh).

# --- Docker Compose SQL Server (macOS/Linux/CI path; not needed with a native Windows SQL Server) ---
MSSQL_SA_PASSWORD=

# --- Hosts (ASP.NET Core reads "__" as ":") ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__ApiArena=
ApiArena__Urls__FrontendBaseUrl=http://localhost:3000
ApiArena__Urls__SimulatorPublicBaseUrl=http://localhost:5151

# --- E-mail (Production requires Smtp) ---
ApiArena__Email__Mode=File
ApiArena__Email__From=
ApiArena__Email__SmtpHost=
ApiArena__Email__SmtpPort=587
ApiArena__Email__SmtpUsername=
ApiArena__Email__SmtpPassword=

# --- Webhooks (v1, OFF by default; see docs/runbooks/EGRESS.md before enabling) ---
ApiArena__Webhooks__Enabled=false
ApiArena__Webhooks__EgressRestrictionAttested=false
ApiArena__Webhooks__EncryptionKeys__Current=
ApiArena__Webhooks__DevLocalReceiver__Enabled=false

# --- Frontend (server-side only) ---
API_INTERNAL_URL=http://localhost:5150

# --- Tests ---
APIARENA_TEST_SQL=

# --- Deployment secret file / production Identity key encryption ---
# Store real values outside the repo; see docs/runbooks/DEPLOYMENT.md.
APIARENA_CONFIG_FILE=
ApiArena__DataProtection__CertificatePath=
ApiArena__DataProtection__CertificatePassword=
ApiArena__DataProtection__PreviousCertificatePaths__0=

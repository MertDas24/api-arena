    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
